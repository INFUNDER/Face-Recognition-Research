#!/bin/bash
#PBS -N hfr_mixed_precision
#PBS -q workq
#PBS -l select=1:ncpus=32:mem=64g
#PBS -l walltime=06:00:00
#PBS -j oe
# zero-shot rows + mixed-precision (stage-selective INT8) evaluations of every CV run, CPU only
cd $PBS_O_WORKDIR
source /home/soft/anaconda3/etc/profile.d/conda.sh
conda activate GPU-env
export OMP_NUM_THREADS=4 CUDA_VISIBLE_DEVICES=""
R=results/hfr/cv
mkdir -p logs/hfr
for S in 0 1 2 3 4 5 6 7; do
    python scripts/hfr/run_experiments.py scripts/hfr/configs/cv.txt --out_root $R --shard $S/8 --lfw \
        --int8_stages 3 0,1,2 > logs/hfr/mixed_precision_$S.log 2>&1 &
done
wait
